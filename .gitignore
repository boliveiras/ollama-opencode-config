# So o que este projeto gera ao rodar. Cruft de editor e de sistema
# operacional e problema da sua maquina, nao deste repositorio: coloque
# no seu ~/.gitignore global.

# Configuracao escrita por 'install.ps1 -ConfigScope Project'. Tem caminho
# local e o modelo daquela maquina: nao serve para mais ninguem.
opencode.json
opencode.json.*.bak

# Log de auditoria do script (-LogPath). Registra usuario e hostname.
*.jsonl

# Saida das ferramentas de qualidade rodadas na mao.
testresults*.xml
*.sarif
